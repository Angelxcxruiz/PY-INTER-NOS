DATABASE_URL=mysql+pymysql://CAMBIAR-EN-PRODUCCION:CAMBIAR-EN-PRODUCCION@127.0.0.1:3306/internos?charset=utf8mb4
# ^ Marcadores: reemplace usuario y contrasena por los de su propia base de datos.

TEST_DATABASE_URL=mysql+pymysql://inter_nos_test:inter_nos_test@127.0.0.1:3307/inter_nos_test?charset=utf8mb4
# SECRETOS: los valores CAMBIAR-EN-PRODUCCION son marcadores, NO credenciales validas.
# JWT_SECRET firma los tokens: use una cadena aleatoria larga, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR-EN-PRODUCCION
JWT_EXPIRA_MIN=60
# FERNET_KEY cifra los codigos de convocatoria. Genere una propia (NO reutilice una publicada):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la cambia, los codigos ya guardados dejan de poder descifrarse: regenerelos desde el panel.
FERNET_KEY=CAMBIAR-EN-PRODUCCION
# Dominio exigido SOLO a los estudiantes; los docentes pueden usar cualquier correo.
# Acepta el dominio y sus subdominios: `edu.co` vale para cualquier universidad @algo.edu.co.
# Puede ser una lista separada por comas (p. ej. edu.co,universidad.edu).
# Es el UNICO lugar donde se define: registro, login de estudiante y alta por el admin la leen de aqui.
DOMINIO_INSTITUCIONAL=edu.co
FRONTEND_URL=http://localhost:3000
# smtp | console | fake. Con smtp se envia por SMTP_HOST:SMTP_PORT (Mailpit local o SES).
# console: SOLO desarrollo local. Imprime el correo completo (incluido el codigo de 6 digitos del
# registro) en la terminal de la API, sin necesitar Mailpit ni SMTP.
EMAIL_BACKEND=smtp
# true: la API despacha el outbox justo despues de registrar/reenviar (sin worker). false: solo el worker.
DESPACHO_INMEDIATO=true
# Verificacion del registro por codigo de 6 digitos
CODIGO_REGISTRO_EXPIRA_MIN=15
CODIGO_REGISTRO_MAX_INTENTOS=5
CODIGO_REGISTRO_COOLDOWN_SEG=60
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Remitente (From). En SES debe ser una direccion o dominio verificado.
SMTP_REMITENTE=no-reply@universidad.edu
ESCALA_NOTA_MAX=5.00
NOTA_APROBATORIA=3.00
FRACCION_INGRESO_TARDIO=0.5
CSV_SEPARADOR=;
CORS_ORIGINS=http://localhost:3000
MAX_INTENTOS=5
# Restablecer contrasena: vigencia del enlace y segundos minimos entre solicitudes
TOKEN_RESTABLECER_EXPIRA_MIN=60
TOKEN_COOLDOWN_SEG=60
# Verificacion de correo del estudiante: vigencia del enlace y minutos entre reenvios
VERIFICACION_EXPIRA_HORAS=48
VERIFICACION_COOLDOWN_MIN=5
# false: la verificacion es informativa. true: el estudiante no entra sin verificar su correo.
EXIGIR_CORREO_VERIFICADO=false
OUTBOX_MAX_INTENTOS=5
OUTBOX_INTERVALO_SEG=10
WORKER_INTERVALO_EXPIRACION_SEG=60
WORKER_INTERVALO_CIERRE_SEG=300
ADMIN_INICIAL_NOMBRE=Administrador Inter Nos
ADMIN_INICIAL_CORREO=admin@universidad.edu
# Contrasenas iniciales del seed y de scripts/reset_passwords.py. Los scripts se niegan a
# ejecutarse mientras valgan CAMBIAR-EN-PRODUCCION.
ADMIN_INICIAL_CONTRASENA=CAMBIAR-EN-PRODUCCION
DOCENTE_PASSWORD=CAMBIAR-EN-PRODUCCION
